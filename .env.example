# Copy to .env.local and adjust as needed. All values are optional.
# Never commit .env.local or real secrets.

# Absolute paths to the media tools (preferred when they are not on PATH).
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Which hosts may be fetched as direct media:
#   allowlist (default) - only the curated hosts in src/lib/sources.ts
#   public              - any public host; private/loopback/link-local addresses
#                         and unsafe redirects are still rejected.
# MEDIA_DOWNLOADER_SOURCE_POLICY=allowlist

# Additional allowlisted direct-media hosts (comma separated).
# MEDIA_DOWNLOADER_EXTRA_HOSTS=media.example.org,cdn.example.org

# Hard cap per download, in megabytes (1-512).
# MEDIA_DOWNLOADER_MAX_FILE_MB=50

# Deadlines in milliseconds.
# MEDIA_DOWNLOADER_REQUEST_TIMEOUT_MS=30000
# MEDIA_DOWNLOADER_DOWNLOAD_TIMEOUT_MS=120000
# MEDIA_DOWNLOADER_CONVERSION_TIMEOUT_MS=120000

# Concurrency: simultaneous jobs and how many may queue before 503.
# MEDIA_DOWNLOADER_MAX_CONCURRENCY=2
# MEDIA_DOWNLOADER_MAX_QUEUE=20

# Redirect hops allowed per download.
# MEDIA_DOWNLOADER_MAX_REDIRECTS=5

# Default MP3 target bitrate. 128/192/320 kbps are offered in the UI.
# MEDIA_DOWNLOADER_MP3_BITRATE=192k

# YouTube metadata lookup. "off" disables it entirely.
# Metadata only: YouTube media files cannot be downloaded by this app.
# MEDIA_DOWNLOADER_YOUTUBE_METADATA=on

# Optional YouTube Data API v3 key (metadata only; adds duration).
# Get one at https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Quota: 10,000 units/day by default; videos.list costs 1 unit per call.
# Without a key the key-free oEmbed endpoint is used.
# YOUTUBE_API_KEY=

# Unused database scaffold; not required by the downloader.
# DATABASE_URL=
