# Copy to .env.local and adjust as needed. All values are optional.
# Never commit .env.local or real secrets.

# Absolute path to an FFmpeg binary (preferred when it is not on PATH).
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Hard cap per download, in megabytes (1-512).
# MEDIA_DOWNLOADER_MAX_FILE_MB=50

# Deadlines in milliseconds.
# MEDIA_DOWNLOADER_REQUEST_TIMEOUT_MS=30000
# MEDIA_DOWNLOADER_DOWNLOAD_TIMEOUT_MS=120000
# MEDIA_DOWNLOADER_CONVERSION_TIMEOUT_MS=120000

# Concurrency: simultaneous jobs and how many may queue before 503.
# MEDIA_DOWNLOADER_MAX_CONCURRENCY=2
# MEDIA_DOWNLOADER_MAX_QUEUE=20

# Redirect hops allowed per download.
# MEDIA_DOWNLOADER_MAX_REDIRECTS=5

# MP3 target bitrate.
# MEDIA_DOWNLOADER_MP3_BITRATE=192k

# Additional allowlisted direct-media hosts (comma separated).
# MEDIA_DOWNLOADER_EXTRA_HOSTS=media.example.org,cdn.example.org
